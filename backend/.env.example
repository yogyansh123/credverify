# CredVerify Backend – environment variable template
# Copy this file to .env and fill in values before running the server.

# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=CredVerify API
APP_VERSION=0.1.0
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────
# SQLite for local development (file created in backend/ directory)
DATABASE_URL=sqlite:///./credverify.db

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of React dev-server origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── File Uploads ───────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# ── Security ───────────────────────────────────────────────────────────────
# IMPORTANT: Replace this before any deployment
SECRET_KEY=changeme-use-a-real-secret-in-production

# ── Supabase Storage ───────────────────────────────────────────────────────
# Optional: Auto-derived from DATABASE_URL if omitted
# SUPABASE_URL=https://<project-ref>.supabase.co
# Secret / service-role key for backend access to private credverify-documents bucket
# SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=credverify-documents
